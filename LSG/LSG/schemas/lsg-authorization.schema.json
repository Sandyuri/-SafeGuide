{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["schema_version","lsg_version","session_id","request_id","evaluation_id","created_at","intent_index","decision","task_type","response_branch","defer_type","confidence","authorization_scope","obligations","normalized_request","evaluated_request","context_snapshot_id","context_snapshot_hash","runtime_candidate_hash","provenance","fail_closed_reason","aggregate_rule","status","terminal"],"properties":{"schema_version":{"const":"lsg.authorization.v0.1"},"lsg_version":{"const":"0.1"},"session_id":{"type":"string","minLength":1},"request_id":{"type":"string","minLength":1},"evaluation_id":{"type":"string","minLength":1},"created_at":{"type":"string","format":"date-time"},"intent_index":{"type":"integer","minimum":1,"maximum":3},"decision":{"enum":["AUTHORIZE","DEFER","REJECT"]},"task_type":{"enum":["RESPONSE_TASK","ROBOT_TASK",null]},"response_branch":{"enum":["CARE_GUIDANCE","PUBLIC_CARE_INFORMATION","MEDICATION_INFORMATION","DEPARTMENT_GUIDANCE",null]},"defer_type":{"enum":["NEEDS_USER_INPUT","HUMAN_ESCALATION_REQUIRED",null]},"confidence":{"type":"object"},"authorization_scope":{"enum":["RESPOND_WITHIN_OBLIGATIONS","ALLOW_TO_ENTER_PLANNING","NONE"]},"obligations":{"type":"array","items":{"type":"string"}},"normalized_request":{"type":"object"},"evaluated_request":{"type":"object"},"context_snapshot_id":{"type":"string"},"context_snapshot_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"runtime_candidate_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"provenance":{"type":"object","required":["splitter_checkpoint_sha256","gate_checkpoint_sha256","splitter_manifest_sha256","gate_manifest_sha256"],"additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"fail_closed_reason":{"type":["string","null"]},"aggregate_rule":{"const":"REJECT > DEFER > AUTHORIZE"},"status":{"type":"string"},"terminal":{"const":true}},"allOf":[{"if":{"properties":{"de