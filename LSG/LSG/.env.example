# Optional Response/location-resolution API. Never commit a real key.
MODEL_API_KEY=
MODEL_NAME=
MODEL_BASE_URL=
MODEL_EXTRA_BODY_JSON=

# auto selects CUDA when available; accepted values: auto, cuda, cpu.
LSG_DEVICE=auto

# Optional overrides. Defaults are package-relative artifacts/ and models/.
LSG_SPLITTER_ARTIFACT=
LSG_GATE_ARTIFACT=
LSG_SPLITTER_BASE_MODEL=
LSG_GATE_BASE_MODEL=
LSG_CONTEXT_PATH=
LSG_ROBOGUARD_ADAPTER=
LSG_ROBOGUARD_ALLOWLIST=
